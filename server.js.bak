require('dotenv').config();
const express = require('express');
const admin = require('firebase-admin');
const cors = require('cors');
const bodyParser = require('body-parser');
const cookieParser = require('cookie-parser');
const axios = require('axios');

// --- Configuração do Firebase Admin ---
try {
  const firebaseConfig = {
    type: process.env.FIREBASE_TYPE,
    project_id: process.env.FIREBASE_PROJECT_ID,
    private_key_id: process.env.FIREBASE_PRIVATE_KEY_ID,
    private_key: process.env.FIREBASE_PRIVATE_KEY.replace(/\\n/g, '\n'), // Substitui literais \n por novas linhas
    client_email: process.env.FIREBASE_CLIENT_EMAIL,
    client_id: process.env.FIREBASE_CLIENT_ID,
    auth_uri: process.env.FIREBASE_AUTH_URI,
    token_uri: process.env.FIREBASE_TOKEN_URI,
    auth_provider_x509_cert_url: process.env.FIREBASE_AUTH_PROVIDER_CERT_URL,
    client_x509_cert_url: process.env.FIREBASE_CLIENT_CERT_URL,
  };

  if (!firebaseConfig.project_id || !firebaseConfig.client_email || !firebaseConfig.private_key) {
    throw new Error('Credenciais do Firebase Admin SDK (project_id, client_email, private_key) não estão completamente definidas no .env.');
  }

  admin.initializeApp({
    credential: admin.credential.cert(firebaseConfig),
    databaseURL: process.env.FIREBASE_DATABASE_URL,
  });
  console.log('Firebase Admin SDK inicializado com sucesso usando variáveis de ambiente.');
} catch (error) {
  console.error('Erro ao inicializar Firebase Admin SDK:', error.message);
  console.error(
    'Certifique-se de que todas as variáveis FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY e FIREBASE_DATABASE_URL estão definidas no .env e corretas.'
  );
  process.exit(1);
}

const auth = admin.auth();
const db = admin.database(); // Firebase Realtime Database

const app = express();
const PORT = process.env.PORT || 4000;

// --- Middlewares ---
app.use(
  cors({
    origin: process.env.FRONTEND_URL || 'http://vailink.pro:9002',
    credentials: true,
  })
);
app.use(cookieParser()); // cookieParser deve vir antes de rotas que o usam
app.use(bodyParser.json());
// O PayPal IPN requer o corpo raw, então o urlencoded para o IPN é tratado especificamente na rota.
// Para outras rotas que podem usar x-www-form-urlencoded:
// app.use(bodyParser.urlencoded({ extended: true })); // Descomente se necessário para outras rotas


// --- Middleware de Autenticação Firebase ---
const authenticate = async (req, res, next) => {
  const authHeader = req.headers.authorization;
  if (!authHeader || !authHeader.startsWith('Bearer ')) {
    return res.status(401).json({ message: 'Token de autorização não fornecido ou mal formatado.' });
  }
  const idToken = authHeader.split('Bearer ')[1];
  try {
    const decodedToken = await auth.verifyIdToken(idToken);
    req.user = decodedToken;
    next();
  } catch (error) {
    console.error('Erro ao verificar token Firebase:', error);
    return res.status(403).json({ message: 'Token inválido ou expirado.' });
  }
};

// --- Rotas ---

app.get('/api/hello', (req, res) => {
  res.json({ message: 'Olá do Backend Express com Firebase RTDB e PayPal!' });
});

// --- Rotas de Autenticação e Usuário ---

app.post('/api/auth/ensure-user', authenticate, async (req, res) => {
  const { uid, email } = req.user;
  const userRef = db.ref(`users/${uid}`);

  try {
    const snapshot = await userRef.once('value');
    if (!snapshot.exists()) {
      const newUser = {
        email: email,
        isPremium: false,
        downloadCount: 0,
        createdAt: new Date().toISOString(),
        paypalPayerEmail: null,
        lastPaypalTxnId: null,
        paypalSubscriptionId: null,
      };
      await userRef.set(newUser);
      console.log(`Novo usuário criado no RTDB: ${uid}`);
      res.status(201).json({ message: 'Usuário criado no RTDB.', ...newUser, uid });
    } else {
      const userData = snapshot.val();
      console.log(`Usuário existente encontrado no RTDB: ${uid}`);
      res.status(200).json({ message: 'Usuário existente.', ...userData, uid });
    }
  } catch (error) {
    console.error('Erro ao garantir usuário no RTDB:', error);
    res.status(500).json({ message: 'Erro interno do servidor ao processar dados do usuário.' });
  }
});

app.get('/api/user/profile', authenticate, async (req, res) => {
  const { uid } = req.user;
  const userRef = db.ref(`users/${uid}`);
  try {
    const snapshot = await userRef.once('value');
    if (!snapshot.exists()) {
      return res.status(404).json({ message: 'Usuário não encontrado.' });
    }
    const userData = snapshot.val();
    res.status(200).json({ uid, ...userData });
  } catch (error) {
    console.error('Erro ao buscar perfil do usuário no RTDB:', error);
    res.status(500).json({ message: 'Erro ao buscar perfil.' });
  }
});

app.post('/api/user/record-download', authenticate, async (req, res) => {
  const { uid } = req.user;
  const userRef = db.ref(`users/${uid}`);

  try {
    const snapshot = await userRef.once('value');
    if (!snapshot.exists()) {
      return res.status(404).json({ message: 'Usuário não encontrado.' });
    }

    const userData = snapshot.val();
    const currentDownloadCount = userData.downloadCount || 0;
    const isPremium = userData.isPremium || false;
    const FREE_DOWNLOAD_LIMIT = parseInt(process.env.FREE_DOWNLOAD_LIMIT || "5");

    if (!isPremium && currentDownloadCount >= FREE_DOWNLOAD_LIMIT) {
      return res.status(403).json({
        message: 'Limite de downloads atingido para usuários gratuitos.',
        downloadCount: currentDownloadCount,
        limit: FREE_DOWNLOAD_LIMIT,
      });
    }

    const newDownloadCount = currentDownloadCount + 1;
    await userRef.update({ downloadCount: newDownloadCount });

    res.status(200).json({
      message: 'Download registrado com sucesso.',
      downloadCount: newDownloadCount,
      limit: isPremium ? Infinity : FREE_DOWNLOAD_LIMIT,
    });
  } catch (error) {
    console.error('Erro ao registrar download no RTDB:', error);
    res.status(500).json({ message: 'Erro ao registrar download.' });
  }
});


// --- Rotas de Pagamento (PayPal IPN) ---
// Usar bodyParser.urlencoded especificamente para esta rota
app.post('/api/payment/paypal-ipn', bodyParser.urlencoded({ extended: true }), async (req, res) => {
  console.log('PayPal IPN recebido:', req.body);

  let ipnRequestBody = 'cmd=_notify-validate';
  for (const key in req.body) {
    if (req.body.hasOwnProperty(key)) {
      const value = encodeURIComponent(req.body[key]);
      ipnRequestBody += `&${key}=${value}`;
    }
  }

  try {
    const paypalVerifyUrl = process.env.PAYPAL_IPN_VERIFY_URL;
    if (!paypalVerifyUrl) {
        console.error('PAYPAL_IPN_VERIFY_URL não está configurado no .env');
        return res.status(500).send('Configuração do servidor incompleta.');
    }

    const verificationResponse = await axios.post(paypalVerifyUrl, ipnRequestBody, {
      headers: {
        'Content-Length': ipnRequestBody.length,
        'Content-Type': 'application/x-www-form-urlencoded',
        'User-Agent': 'NodeJS-IPN-VerificationScript',
      },
    });

    console.log('Resposta de verificação do PayPal IPN:', verificationResponse.data);

    if (verificationResponse.data === 'VERIFIED') {
      console.log('IPN Verificado com sucesso.');

      const {
        payment_status,
        receiver_email,
        mc_gross,
        mc_currency,
        txn_id,
        txn_type,
        custom, // UID do Firebase que VOCÊ DEVE PASSAR AQUI
        payer_email,
        subscr_id
      } = req.body;

      if (payment_status !== 'Completed') {
        console.log(`IPN ignorado: payment_status não é 'Completed' (é '${payment_status}').`);
        return res.status(200).send('OK');
      }
      if (receiver_email !== process.env.PAYPAL_RECEIVER_EMAIL) {
        console.error(`IPN ignorado: receiver_email ('${receiver_email}') não corresponde ao configurado ('${process.env.PAYPAL_RECEIVER_EMAIL}').`);
        return res.status(200).send('OK');
      }
       // Ajuste para permitir pequena variação de preço ou se o preço for dinâmico.
       // Por agora, vamos manter uma verificação simples.
      if (parseFloat(mc_gross) < (parseFloat(process.env.PREMIUM_PLAN_PRICE) - 0.01) || mc_currency !== process.env.PREMIUM_PLAN_CURRENCY) {
        console.warn(`IPN alerta: mc_gross ('${mc_gross} ${mc_currency}') não corresponde estritamente ao preço/moeda do plano ('${process.env.PREMIUM_PLAN_PRICE} ${process.env.PREMIUM_PLAN_CURRENCY}'). Verificando se a diferença é aceitável.`);
        // Para um único plano, pode ser bom ser estrito, mas para múltiplos planos ou flutuações, você pode precisar de lógica mais flexível.
      }


      if (!custom) {
        console.error('IPN erro crítico: Campo "custom" (Firebase UID) não recebido do PayPal. Não é possível atualizar o usuário.');
        return res.status(200).send('OK');
      }
      const firebaseUID = custom;
      const userRef = db.ref(`users/${firebaseUID}`);
      const snapshot = await userRef.once('value');

      if (!snapshot.exists()) {
        console.error(`IPN erro: Usuário com UID '${firebaseUID}' (do campo custom) não encontrado no RTDB.`);
        return res.status(200).send('OK');
      }
      
      const userData = snapshot.val();
      if (userData.lastPaypalTxnId === txn_id) {
          console.log(`IPN ignorado: Transação txn_id '${txn_id}' já processada para o usuário ${firebaseUID}.`);
          return res.status(200).send('OK');
      }

      const updates = {
        isPremium: true,
        paypalPayerEmail: payer_email,
        lastPaypalTxnId: txn_id,
        ...(subscr_id && { paypalSubscriptionId: subscr_id }),
        // downloadCount: 0, // Opcional: Resetar contagem de downloads no upgrade
      };
      await userRef.update(updates);
      console.log(`Usuário ${firebaseUID} atualizado para premium via PayPal IPN. Txn ID: ${txn_id}`);

    } else if (verificationResponse.data === 'INVALID') {
      console.error('IPN Inválido. A mensagem pode ter sido adulterada ou é um teste inválido.');
    } else {
      console.warn('IPN não verificado. Resposta do PayPal:', verificationResponse.data);
    }
  } catch (error) {
    console.error('Erro ao verificar PayPal IPN:', error.response ? error.response.data : error.message);
  }
  res.status(200).send('IPN Processado');
});


// --- Tratamento de Erros Global ---
app.use((err, req, res, next) => {
  console.error(err.stack);
  res.status(500).json({ message: 'Ocorreu um erro inesperado no servidor.' });
});

// --- Iniciar Servidor ---
app.listen(PORT, () => {
  console.log(`Servidor backend rodando na porta ${PORT}`);
  console.log(`Frontend esperado em: ${process.env.FRONTEND_URL || 'http://vailink.pro:9002'}`);
  if (!process.env.FIREBASE_PROJECT_ID || !process.env.FIREBASE_CLIENT_EMAIL || !process.env.FIREBASE_PRIVATE_KEY || !process.env.FIREBASE_DATABASE_URL) {
    console.warn("AVISO: Alguma das variáveis de ambiente do Firebase Admin (PROJECT_ID, CLIENT_EMAIL, PRIVATE_KEY, DATABASE_URL) não está definida. O Firebase Admin SDK pode não inicializar corretamente.");
  }
  if (!process.env.PAYPAL_RECEIVER_EMAIL || !process.env.PAYPAL_IPN_VERIFY_URL) {
    console.warn("AVISO: PAYPAL_RECEIVER_EMAIL ou PAYPAL_IPN_VERIFY_URL não estão definidos. A integração com PayPal IPN pode não funcionar.");
  }
});