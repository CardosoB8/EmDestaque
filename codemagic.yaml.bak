workflows:
  android-workflow:
    name: Build Android APK
    environment:
      vars:
        
    scripts:
      - name: Make Gradle executable
        script: chmod +x ./gradlew
      - name: Clean
        script: ./gradlew clean
      - name: Build APK
        script: ./gradlew assembleRelease
    artifacts:
      - app/build/outputs/apk/release/app-release.apk
