workflows:
  android-workflow:
    name: Android Build
    max_build_duration: 45

    scripts:
      - name: Make Gradlew Executable
        script: chmod +x gradlew

      - name: Clean
        script: ./gradlew clean

      - name: Build Debug APK
        script: ./gradlew assembleDebug

      - name: Find generated APKs
        script: find . -type f -name "*.apk"

    artifacts:
      # ajuste este caminho para bater com o que o `find` te mostrou
      - app/build/outputs/apk/debug/*.apk

    publishing:
      email:
        recipients:
          - maisconhe@gmail.com