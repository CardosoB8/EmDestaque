workflows:
  android-workflow:
    name: Android Build
    max_build_duration: 45

    scripts:
      - name: Make Gradlew Executable
        script: |
          chmod +x gradlew

      - name: Clean
        script: ./gradlew clean

      - name: Build Debug APK
        script: ./gradlew assembleDebug

    artifacts:
      - app/build/outputs/**/*.apk

    publishing:
      email:
        recipients:
          - maisconhe@gmail.com