workflows:
  android-workflow:
    name: Android Build
    max_build_duration: 45

    scripts:
      - name: Make Gradlew Executable
        script: chmod +x gradlew

      - name: Clean
        script: ./gradlew clean

      - name: Build Debug APK
        script: ./gradlew assembleDebug

      - name: Dump all outputs
        script: |
          echo "===== Diretório de outputs completo ====="
          ls -R app/build/outputs/

      - name: List generated APKs
        script: |
          echo ">> APKs gerados:"
          find . -type f -name "*.apk"

    artifacts:
      # Ajuste este padrão ao caminho exato que o `Dump all outputs` revelou
      - app/build/outputs/apk/debug/*.apk

    publishing:
      email:
        recipients:
          - maisconhe@gmail.com